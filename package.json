{
  "name": "askwell",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @askwell/web dev",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "build": "turbo run build",
    "db:types": "pnpm --filter @askwell/db db:types"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "eslint": "^10.15.0",
    "eslint-config-next": "^16.4.6",
    "turbo": "^2.11.13",
    "typescript": "^5.9.3",
    "vitest": "^5.1.1"
  }
}
